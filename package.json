{
  "name": "@miragari/dsh-client-canvas",
  "version": "0.1.4",
  "description": "An AI-native multimodal canvas for DSH: preview images, video, audio, 3D models, PDFs, documents, and code; connect ideas and collaborate with agents in a persistent local workspace.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "docs",
    "locale",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-office-to-pdf": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.2 <0.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xindong/dsh-client-canvas.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync:runtime": "bash scripts/sync-runtime.sh",
    "sync:upstream": "node scripts/update-upstream.mjs",
    "start": "bash scripts/start-local.sh",
    "setup:previews": "node scripts/setup-preview-runtime.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.10",
    "@xindong/dsh-canvas": "github:xindong/dsh-canvas#2b29c1dc6e5e003ce255fa9419b6647cf555fa45",
    "fflate": "0.8.3",
    "markdown-it": "15.0.2",
    "mivo-model-viewer": "0.7.0",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.64.0",
    "pixiboardjs": "0.1.0-alpha.6",
    "sharp": "0.35.5",
    "three": "0.185.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-office-to-pdf": {
      "optional": true
    }
  },
  "author": {
    "name": "Kagari (maoxinxin-xd)",
    "url": "https://github.com/maoxinxin-xd"
  },
  "homepage": "https://github.com/xindong/dsh-client-canvas#readme",
  "bugs": {
    "url": "https://github.com/xindong/dsh-client-canvas/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ai-native",
    "canvas",
    "multimodal",
    "agent",
    "image",
    "video",
    "audio",
    "3d",
    "pixiboardjs"
  ]
}

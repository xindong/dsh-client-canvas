{
  "name": "@xindong/dsh-client-canvas",
  "version": "0.1.0",
  "description": "DSH view and persistence adapter for the upstream PixiBoardSDK site",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-office-to-pdf": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xindong/dsh-client-canvas.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync:runtime": "bash scripts/sync-runtime.sh",
    "sync:upstream": "node scripts/update-upstream.mjs",
    "start": "bash scripts/start-local.sh",
    "setup:previews": "node scripts/setup-preview-runtime.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.10",
    "@xindong/dsh-canvas": "github:xindong/dsh-canvas#db36582d33234f8e47808d2525482307bde83b47",
    "fflate": "0.8.3",
    "markdown-it": "15.0.2",
    "mivo-model-viewer": "0.7.0",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.64.0",
    "pixiboardjs": "0.1.0-alpha.5",
    "sharp": "0.35.5",
    "three": "0.185.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-office-to-pdf": {
      "optional": true
    }
  }
}
